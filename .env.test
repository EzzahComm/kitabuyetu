# ──────────────────────────────────────────────────────────────────────────────
# Local env for `npm run test:integration` (Jest auto-loads this when
# NODE_ENV=test, matching Next.js's own .env.test convention).
#
# These are NOT real secrets — mirrors the same fake values .github/workflows/
# ci.yml uses so lib/env.ts validation passes. DATABASE_URL is the one real
# value: it points at the local docker-compose Postgres (`docker compose up -d
# postgres`), matching docker-compose.yml's default user/password/db.
# ──────────────────────────────────────────────────────────────────────────────

NODE_ENV=test
NEXT_PUBLIC_APP_URL=http://localhost:3000

DATABASE_URL=postgresql://kitabuyetu:changeme@localhost:5432/kitabuyetu
DB_POOL_MAX=5

REDIS_URL=rediss://default:test_fake@test.upstash.io:6379

JWT_SECRET=test_placeholder_secret_minimum_32_chars
ENCRYPTION_KEY=test_placeholder_enckey_minimum_32_chars
WORKER_SECRET=test_placeholder_worker_minimum_32_chars
CRON_SECRET=test_placeholder_cron__minimum_32_chars_

MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=test_fake
MPESA_CONSUMER_SECRET=test_fake
MPESA_SHORTCODE=174379
MPESA_PASSKEY=test_fake
MPESA_CALLBACK_BASE_URL=http://localhost:3000

TEXTSMS_API_KEY=test_fake
TEXTSMS_SENDER_ID=KITABU YETU
TEXTSMS_PARTNER_ID=test_fake

EMAIL_PROVIDER=resend
EMAIL_FROM=noreply@kitabuyetu.co.ke
EMAIL_DRY_RUN=true
RESEND_API_KEY=re_test_fake

CSV_MAX_ROWS=5000
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=30
