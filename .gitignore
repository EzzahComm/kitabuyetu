# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
.next/
out/
build/
dist/

# Environment — NEVER commit real secrets
.env
.env.local
.env.*.local

# Supabase local state
supabase/.temp/
supabase/.branches/

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/settings.json
.idea/

# Standalone output (built by CI, not source-controlled)
.next/standalone/

# TypeScript incremental build cache
*.tsbuildinfo

.vercel
.env*.local

# Jest coverage output
coverage/

.vercel
# Every local env file is ignored by default (added by `vercel link`).
# .env.test is the deliberate exception: CI reads it from the repo, and it
# holds only throwaway test values. Without this negation a delete-and-re-add
# would silently drop it and every integration run would lose its config.
.env*
!.env.test
