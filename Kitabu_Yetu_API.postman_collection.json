{
  "info": {
    "name": "Kitabu Yetu API",
    "description": "API collection for Kitabu Yetu — Kenyan community-group financial platform",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"groupName\": \"Test Group\",\n  \"groupType\": \"chama\",\n  \"firstName\": \"Test\",\n  \"lastName\": \"User\",\n  \"phone\": \"+254700000000\",\n  \"email\": \"test@example.com\",\n  \"password\": \"SecurePassword123!\",\n  \"creatorRole\": \"chairperson\",\n  \"primaryObjective\": \"savings\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "register"]
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+254700000000\",\n  \"password\": \"SecurePassword123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{refresh_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/refresh",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "refresh"]
            }
          }
        }
      ]
    },
    {
      "name": "Groups",
      "item": [
        {
          "name": "List Groups",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{api_base}}/v1/groups",
              "host": ["{{api_base}}"],
              "path": ["v1", "groups"]
            }
          }
        },
        {
          "name": "Get Group Details",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{api_base}}/v1/groups/{{group_id}}",
              "host": ["{{api_base}}"],
              "path": ["v1", "groups", "{{group_id}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Members",
      "item": [
        {
          "name": "List Members",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{api_base}}/v1/members?groupId={{group_id}}",
              "host": ["{{api_base}}"],
              "path": ["v1", "members"],
              "query": [
                {
                  "key": "groupId",
                  "value": "{{group_id}}"
                }
              ]
            }
          }
        },
        {
          "name": "Get Member Details",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{api_base}}/v1/members/{{member_id}}",
              "host": ["{{api_base}}"],
              "path": ["v1", "members", "{{member_id}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Contributions",
      "item": [
        {
          "name": "List Contributions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{api_base}}/v1/contributions?groupId={{group_id}}",
              "host": ["{{api_base}}"],
              "path": ["v1", "contributions"],
              "query": [
                {
                  "key": "groupId",
                  "value": "{{group_id}}"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Changi$ha - Fundraising",
      "item": [
        {
          "name": "List Active Campaigns",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/fundraise",
              "host": ["{{base_url}}"],
              "path": ["fundraise"]
            }
          }
        },
        {
          "name": "Get Campaign by Slug",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/fundraise/campaign-slug",
              "host": ["{{base_url}}"],
              "path": ["fundraise", "campaign-slug"]
            }
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Get Platform Analytics",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": {
              "raw": "{{admin_api}}/analytics",
              "host": ["{{admin_api}}"],
              "path": ["analytics"]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "https://www.kitabuyetu.co.ke"
    },
    {
      "key": "api_base",
      "value": "https://www.kitabuyetu.co.ke/api"
    },
    {
      "key": "admin_api",
      "value": "https://www.kitabuyetu.co.ke/api/admin"
    },
    {
      "key": "supabase_url",
      "value": "https://qztcgryhoanennsizcll.supabase.co"
    },
    {
      "key": "supabase_anon_key",
      "value": ""
    }
  ]
}
