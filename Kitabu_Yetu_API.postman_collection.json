{
  "info": {
    "name": "Kitabu Yetu API",
    "description": "API collection for Kitabu Yetu — Kenyan community-group financial platform",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"groupName\": \"Local QA Group\",\n  \"groupType\": \"chama\",\n  \"firstName\": \"Test\",\n  \"lastName\": \"Officer\",\n  \"phone\": \"{{phone}}\",\n  \"password\": \"{{password}}\",\n  \"countyId\": \"{{county_id}}\",\n  \"creatorRole\": \"chairperson\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "register"]
            },
            "description": "Use a disposable local database. Select a county_id from GET /api/v1/jurisdictions/counties before registration."
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"{{identifier}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "description": "Use your test phone number or email. If the response requests group selection, resubmit with the selected groupCode."
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/refresh",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "refresh"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Use the new accessToken and refreshToken returned by each successful refresh."
          }
        }
      ]
    },
    {
      "name": "Groups",
      "item": [
        {
          "name": "List My Group Memberships",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/memberships",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "memberships"]
            }
          }
        }
      ]
    },
    {
      "name": "Members",
      "item": [
        {
          "name": "List Members",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/members",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "members"]
            }
          }
        },
        {
          "name": "Get Member Details",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/members/{{member_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "members", "{{member_id}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Contributions",
      "item": [
        {
          "name": "List Contributions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/contributions",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "contributions"]
            }
          }
        }
      ]
    },
    {
      "name": "Changi$ha - Fundraising",
      "item": [
        {
          "name": "List Active Campaigns",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/fundraise",
              "host": ["{{base_url}}"],
              "path": ["fundraise"]
            }
          }
        },
        {
          "name": "Get Campaign by Slug",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/fundraise/{{campaign_slug}}",
              "host": ["{{base_url}}"],
              "path": ["fundraise", "{{campaign_slug}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Get Platform Analytics",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/admin/analytics",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "analytics"]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:3000",
      "type": "string"
    },
    {
      "key": "identifier",
      "value": "",
      "type": "string"
    },
    {
      "key": "password",
      "value": "",
      "type": "string"
    },
    {
      "key": "phone",
      "value": "",
      "type": "string"
    },
    {
      "key": "county_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "refresh_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "admin_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "member_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "campaign_slug",
      "value": "",
      "type": "string"
    }
  ]
}
