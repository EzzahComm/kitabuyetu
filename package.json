{
  "name": "kitabuyetu",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "brand:assets": "tsx scripts/brand/generate-brand-assets.ts",
    "brand:check": "tsx scripts/brand/check-brand.ts",
    "email": "email dev --dir emails --port 3030",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:coverage:summary": "jest --ci --coverage --coverageReporters=json-summary --coverageReporters=text-summary --coverageThreshold={}",
    "health": "node scripts/health/report.mjs --baseline docs/health/baseline.json",
    "test:ci": "jest --ci --forceExit",
    "test:integration": "jest --config jest.integration.config.ts --runInBand --forceExit",
    "test:integration:app-tenant": "jest --config jest.integration.app-tenant.config.ts --runInBand --forceExit",
    "ci": "npm run lint && npm run typecheck && npm run test:ci && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
