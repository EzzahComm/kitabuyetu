# Web3Forms access key, used by both contact forms (the /contact page form and
# the floating chat widget) to route submissions to your inbox.
#
# Get one free at https://web3forms.com — enter the email that should receive
# submissions, no account or password needed, and they'll email you the key.
#
# This is meant to be public: it ships in the client bundle (NEXT_PUBLIC_*) and
# only identifies where a submission should be delivered, the same way a
# Formspree form ID or Google Analytics measurement ID is public. It is not a
# secret and does not grant access to anything.
#
# Copy this file to .env.local (gitignored) and fill in the real value.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Official Kitabu Yetu product URL. Sign-up and sign-in CTAs link into it.
# Defaults to https://kitabuyetu.vercel.app when unset.
NEXT_PUBLIC_APP_URL=https://kitabuyetu.vercel.app

# Sanity (kitabuyetu-studio — see the sibling project directory) backs the
# public /resources blog. Provisioned through Vercel's Marketplace Sanity
# integration on this project (Storage tab → Marketplace Database Providers →
# Sanity), which injects these automatically — nothing to fill in by hand in
# a real deployment. NEXT_PUBLIC_* because content reads use Sanity's public
# CDN API, the same way a Google Analytics ID is public.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production


# ── Administrator activity alerts (lib/notifications) ──────────────────────────
# Where Kitabu Yetu's platform activity alerts are sent. Comma-separated lists are
# accepted. Set these in Vercel (Production + Preview); alerts have no recipient
# without them and the app logs a warning.
KITABU_ADMIN_ALERT_PHONE=+254182625807
KITABU_ADMIN_ALERT_EMAIL=info@kitabuyetu.co.ke
# Optional tunables
# KITABU_HIGH_VALUE_THRESHOLD_KES=100000   # routine payments at/above this are alerted individually
# KITABU_ADMIN_DIGEST_MINUTES=60           # window for the aggregated activity digest (min 5)
# Existing providers used for delivery (no second provider is introduced):
#   SMS   → TEXTSMS_* / TEXTSMS_SENDER_ID     Email → EMAIL_PROVIDER, EMAIL_FROM, RESEND_API_KEY / SMTP_*
# Uptime monitoring: point an external monitor (UptimeRobot, Better Stack…) at
#   GET /api/health               (public liveness)
#   GET /api/health/deep          (DB + Redis; header x-worker-secret: $WORKER_SECRET)
# and route its alerts to the phone/email above — only an external monitor can report a total outage.

# ── Email via the info@kitabuyetu.co.ke mailbox (cPanel / Truehost SMTP) ──────
# Uses the existing SMTP adapter (lib/email/adapters/smtp.ts); no code change.
# Port 465 is implicit TLS, so SMTP_SECURE must be "true". The password is the
# mailbox's own password: set it ONLY in Vercel (Production + Preview) as a
# sensitive variable — never commit it or paste it into chat or an issue.
# EMAIL_PROVIDER=smtp
# EMAIL_FROM=info@kitabuyetu.co.ke
# EMAIL_FROM_NAME=Kitabu Yetu
# SMTP_HOST=das121.truehost.cloud
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=info@kitabuyetu.co.ke
# SMTP_PASSWORD=

# ── Department mailboxes (lib/departments.ts; see docs/DEPARTMENT_EMAILS.md) ───
# Defaults are the real cPanel mailboxes; override only if one moves.
# KITABU_EMAIL_ADMIN=admin@kitabuyetu.co.ke
# KITABU_EMAIL_BILLING=billing@kitabuyetu.co.ke
# KITABU_EMAIL_SUPPORT=support@kitabuyetu.co.ke
# KITABU_EMAIL_HR=hr@kitabuyetu.co.ke
# KITABU_EMAIL_ENTERPRISE=enterprise@kitabuyetu.co.ke
# Staff channel used by SMS-health / background-control alerts:
# EMAIL_ADMIN=admin@kitabuyetu.co.ke
