# ─────────────────────────────────────────────────────────────
# Kitabu Yetu — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to git. Add it to .gitignore.
# All keys are validated at startup by lib/env.ts.
# ─────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# ── Database — Supabase direct connection ─────────────────────
# Use the DIRECT connection (port 5432), NOT pgBouncer (port 6543).
# The app uses SET LOCAL for RLS; pgBouncer transaction mode doesn't support this.
# Get from: Supabase Dashboard > Settings > Database > Connection string > URI
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Max connections per serverless instance. Total = DB_POOL_MAX × warm instances.
# Keep ≤ 5 on Vercel (Supabase free tier: 60 connections; Pro: 200).
DB_POOL_MAX=3

# ── Redis — Upstash ───────────────────────────────────────────
# Create a free Redis database at https://console.upstash.com
# Use the ioredis-compatible URL (starts with rediss://).
REDIS_URL=rediss://default:[TOKEN]@[HOST].upstash.io:6379
REDIS_PREFIX=ky:

# ── JWT ───────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
JWT_SECRET=change-me-to-at-least-32-random-hex-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Encryption (PII at rest) ──────────────────────────────────
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=change-me-to-at-least-32-random-hex-chars

# ── Worker / Cron auth ────────────────────────────────────────
# Used to authenticate manual POST calls to /api/v1/workers/cron.
# Generate: openssl rand -hex 32
WORKER_SECRET=change-me-to-at-least-32-random-hex-chars

# Set automatically by Vercel for Vercel Cron GET requests.
# Copy from Vercel Dashboard > Project > Settings > Environment Variables after first deploy.
CRON_SECRET=

# ── M-Pesa (Safaricom Daraja) ─────────────────────────────────
# Portal: https://developer.safaricom.co.ke
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
MPESA_CALLBACK_URL=https://your-app.vercel.app/api/v1/mpesa/callback
MPESA_B2C_INITIATOR_NAME=testapi
MPESA_B2C_INITIATOR_PASSWORD=Safaricom999!*!
MPESA_B2C_QUEUE_TIMEOUT_URL=https://your-app.vercel.app/api/v1/mpesa/b2c/timeout
MPESA_B2C_RESULT_URL=https://your-app.vercel.app/api/v1/mpesa/b2c/result

# ── SMS — Africa's Talking ────────────────────────────────────
# Portal: https://africastalking.com
AT_API_KEY=your_africastalking_api_key
AT_USERNAME=sandbox
AT_SENDER_ID=KitabuYetu

# ── SMS — TextSMS Kenya (alternative) ────────────────────────
TEXTSMS_API_KEY=
TEXTSMS_SENDER_ID=
TEXTSMS_PARTNER_ID=

# ── Email ─────────────────────────────────────────────────────
# Provider: resend (default) | sendgrid | ses | mailgun | smtp
EMAIL_PROVIDER=resend
EMAIL_FROM=noreply@yourdomain.com
EMAIL_ADMIN=admin@yourdomain.com
# Set to true to log emails without sending (staging / smoke test)
EMAIL_DRY_RUN=false

# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_...
RESEND_WEBHOOK_SECRET=

# SendGrid (if EMAIL_PROVIDER=sendgrid)
SENDGRID_API_KEY=

# ── Auth policy ───────────────────────────────────────────────
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=30

# ── Import limits ─────────────────────────────────────────────
CSV_MAX_ROWS=5000
