# ─────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# ─────────────────────────────────────────────
# Database — Supabase
# ─────────────────────────────────────────────
# IMPORTANT: Use the DIRECT connection string (port 5432), NOT the pgBouncer
# pooler (port 6543). The app uses SET LOCAL for RLS which requires a real
# transaction-scoped session — pgBouncer transaction mode does not support this.
#
# Get from: Supabase Dashboard > Settings > Database > Connection string > URI
# It looks like: postgresql://postgres:[PASSWORD]@db.qztcgryhoanennsizcll.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.qztcgryhoanennsizcll.supabase.co:5432/postgres

# ─────────────────────────────────────────────
# Redis — Upstash (recommended with Supabase)
# ─────────────────────────────────────────────
# Create a free Redis DB at https://console.upstash.com
# Use the "ioredis" compatible URL from the Upstash console (starts with rediss://)
REDIS_URL=rediss://default:[TOKEN]@[HOST].upstash.io:6379

# ─────────────────────────────────────────────
# JWT
# ─────────────────────────────────────────────
JWT_SECRET=change-me-to-a-64-char-random-hex-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─────────────────────────────────────────────
# M-Pesa (Safaricom Daraja)
# ─────────────────────────────────────────────
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
MPESA_CALLBACK_URL=https://yourdomain.com/api/v1/mpesa/callback
MPESA_B2C_INITIATOR_NAME=testapi
MPESA_B2C_INITIATOR_PASSWORD=Safaricom999!*!

# ─────────────────────────────────────────────
# Africa's Talking (SMS)
# ─────────────────────────────────────────────
AT_API_KEY=your_africastalking_api_key
AT_USERNAME=sandbox
AT_SENDER_ID=KitabuYetu

# ─────────────────────────────────────────────
# Email
# ─────────────────────────────────────────────
# Provider: resend (default) | sendgrid | ses | mailgun | smtp
EMAIL_PROVIDER=resend
EMAIL_FROM=noreply@kitabuyetu.com
# Recipient for admin CC on overdue billing notices
EMAIL_ADMIN=admin@kitabuyetu.com
# Set to 'true' to log emails without actually sending (safe for staging)
EMAIL_DRY_RUN=false

# ─────────────────────────────────────────────
# Encryption (for PII at rest)
# ─────────────────────────────────────────────
ENCRYPTION_KEY=change-me-to-32-random-bytes-hex
